/* ==================== 全局样式 ==================== */
/* 基础重置与布局 */

page {
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ==================== 通用容器 ==================== */

.container,
.page-container,
.game-page {
  min-height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  background: var(--page-bg, #FFF5F0);
  color: var(--text-primary, #2D3436);
}

/* ==================== 按钮样式系统 ==================== */

/* 主要按钮 */
.btn {
  width: 552rpx;
  height: 88rpx;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--button-primary-text, #FFFFFF);
  background: linear-gradient(135deg, var(--accent-from, #FF8E53) 0%, var(--accent-to, #FF6B6B) 100%);
  box-shadow: 0 8rpx 24rpx var(--game-card-shadow, rgba(0, 0, 0, 0.15));
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.btn::after {
  border: none;
}

.btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.2);
  opacity: 0;
  transition: opacity 0.3s;
}

.btn:active::before {
  opacity: 1;
}

.btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 次要按钮 */
.btn-secondary {
  background: rgba(255, 255, 255, 0.3) !important;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: var(--header-text-white, #FFFFFF);
}

/* 小按钮 */
.btn-small {
  width: auto;
  min-width: 160rpx;
  height: 64rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
}

/* ==================== 卡片样式 ==================== */

.card {
  background: var(--game-card-bg, #FFFFFF);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx var(--game-card-shadow, rgba(0, 0, 0, 0.08));
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.card:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* ==================== 头部统计卡片 ==================== */

.header {
  width: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 30rpx;
}

.header-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  flex: 1;
}

.stat-box {
  min-width: 140rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  text-align: center;
  backdrop-filter: blur(20rpx);
  box-shadow: 0 4rpx 16rpx var(--game-card-shadow, rgba(0, 0, 0, 0.1));
  background: var(--header-card-bg, linear-gradient(135deg, rgba(255, 107, 107, 0.9) 0%, rgba(255, 142, 83, 0.9) 100%));
}

.stat-label {
  display: block;
  font-size: 22rpx;
  margin-bottom: 4rpx;
  color: var(--header-text-light, rgba(255, 255, 255, 0.85));
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--header-text-white, #FFFFFF);
}

/* 统一游戏页顶部布局：左侧标题，右侧核心状态。 */
.container .game-topbar {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 0;
  margin-bottom: 24rpx;
}

.game-title-block {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  flex: 1;
}

.game-title {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
  color: var(--primary, #FF6B6B);
}

.game-subtitle {
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--text-secondary, #636E72);
}

.container .game-stats {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
  gap: 12rpx;
  flex: none;
}

.container .game-stat {
  min-width: 106rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
}

.container .game-stat .stat-label,
.container .game-stat .score-label {
  font-size: 20rpx;
  margin-bottom: 3rpx;
}

.container .game-stat .stat-value,
.container .game-stat .score-value {
  font-size: 30rpx;
}

.best-record-bar {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  margin: -10rpx 0 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.35;
  color: var(--text-primary, #2D3436);
  background: rgba(255, 255, 255, 0.48);
  box-shadow: 0 4rpx 16rpx var(--game-card-shadow, rgba(0, 0, 0, 0.08));
}

/* ==================== 游戏棋盘容器 ==================== */

.game-board {
  position: relative;
  width: 552rpx;
  aspect-ratio: 1;
  background: var(--panel-bg, rgba(255, 255, 255, 0.25));
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 20rpx;
  box-shadow: 0 16rpx 48rpx var(--game-card-shadow, rgba(0, 0, 0, 0.15)),
              inset 0 1rpx 1rpx rgba(255, 255, 255, 0.3);
}

/* ==================== 覆盖层（游戏结束/胜利） ==================== */

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--overlay-bg, rgba(255, 255, 255, 0.25));
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 10;
}

.overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.overlay-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: slideUp 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.overlay-title {
  font-size: 72rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  color: var(--header-text-white, #FFFFFF);
}

.overlay-title-danger {
  color: var(--danger, #FF6B6B);
}

.overlay-title-win {
  color: var(--gold-from, #FFD93D);
}

.overlay-text {
  font-size: 32rpx;
  margin-bottom: 30rpx;
  color: var(--header-text-white, #FFFFFF);
}

.overlay-info {
  font-size: 28rpx;
  margin-bottom: 12rpx;
  opacity: 0.9;
  color: var(--header-text-white, #FFFFFF);
}

.overlay-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.overlay-score {
  font-size: 80rpx;
  font-weight: 800;
  margin-bottom: 40rpx;
  color: var(--gold-from, #FFD93D);
}

.btn-restart {
  min-width: 220rpx;
}

/* 统一暂停态遮罩。普通视图游戏和 Canvas 游戏都使用同一套 overlay 文案与样式。 */
.pause-overlay-card {
  background: var(--overlay-bg, rgba(45, 52, 54, 0.78));
}

.pause-overlay-card .overlay-content {
  gap: 10rpx;
}

.pause-overlay-card .overlay-title {
  font-size: 52rpx;
  margin-bottom: 0;
}

.pause-overlay-card .overlay-info,
.pause-overlay-card .overlay-text {
  font-size: 26rpx;
  margin-bottom: 0;
}

/* 页面级弹窗：用于选关、整页结算等不依赖棋盘尺寸的弹层。 */
.app-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: var(--overlay-bg, rgba(45, 52, 54, 0.78));
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.app-modal.show {
  opacity: 1;
  pointer-events: auto;
}

.app-modal-content {
  width: 100%;
  max-width: 640rpx;
  box-sizing: border-box;
  padding: 36rpx;
  border-radius: 32rpx;
  background: var(--game-card-bg, #FFFFFF);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.18);
  animation: scaleIn 0.22s ease;
}

.app-modal-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 40rpx;
  font-weight: 900;
  text-align: center;
  color: var(--primary, #FF6B6B);
}

.app-modal-info {
  display: block;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  text-align: center;
  color: var(--text-secondary, #636E72);
}

/* ==================== 操作提示 ==================== */

.tips {
  margin-top: 30rpx;
  font-size: 26rpx;
  opacity: 0.8;
  text-align: center;
  color: var(--tips-text, #636E72);
}

/* ==================== 动画定义 ==================== */

@keyframes slideUp {
  from {
    transform: translateY(60rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes scaleIn {
  from {
    transform: scale(0.8);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

/* ==================== 工具类 ==================== */

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ==================== 主题化组件 ==================== */

.theme-btn {
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 160rpx !important;
  height: 64rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 32rpx !important;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  color: var(--header-text-white, #FFFFFF);
  background: var(--header-card-bg, linear-gradient(135deg, rgba(255, 107, 107, 0.9) 0%, rgba(255, 142, 83, 0.9) 100%));
  box-shadow: 0 4rpx 16rpx var(--game-card-shadow, rgba(0, 0, 0, 0.1));
  flex-shrink: 0;
  white-space: nowrap;
  line-height: 64rpx;
}

.theme-btn::after {
  border: none !important;
}

.theme-icon {
  font-size: 28rpx;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-center {
  text-align: center;
}

/* ==================== 响应式间距 ==================== */

/* 标题间距 */
.title-spacing {
  margin-bottom: 60rpx;
}

/* 区块间距 */
.section-spacing {
  margin-bottom: 40rpx;
}

/* 小间距 */
.small-spacing {
  margin-bottom: 20rpx;
}
