/* ==================== 首页样式 ==================== */

/* 页面容器 */
.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden; /* 防止整体滚动 */
}

/* 头部区域 */
.page-header {
  padding: 40rpx 40rpx 20rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
}

/* 品牌区域 */
.brand-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.brand-icon {
  font-size: 56rpx;
  line-height: 1;
}

.brand-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.brand-title {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 2rpx;
  color: var(--primary, #FF6B6B);
}

.brand-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary, #636E72);
  opacity: 0.8;
}

.header-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

/* 主题切换按钮 */
.theme-btn {
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 160rpx !important; /* 固定宽度，强制生效 */
  height: 64rpx !important; /* 固定高度，强制生效 */
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 32rpx !important;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0; /* 防止被压缩 */
  white-space: nowrap; /* 防止文字换行 */
  line-height: 64rpx; /* 垂直居中 */
}

.theme-btn::after {
  border: none !important; /* 移除微信小程序默认边框 */
}

.theme-icon {
  font-size: 28rpx;
}

.header-btn {
  width: 132rpx !important;
}

.settings-btn {
  background: var(--game-card-bg, #FFFFFF) !important;
  color: var(--primary, #FF6B6B) !important;
}

/* 游戏滚动区域 */
.game-scroll {
  flex: 1;
  height: 0;
  overflow-y: auto; /* 允许垂直滚动 */
  overflow-x: hidden; /* 隐藏横向滚动 */
}

.scroll-content {
  box-sizing: border-box;
  padding: 20rpx 40rpx 40rpx;
}

.recent-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  color: var(--button-primary-text, #FFFFFF);
  background: linear-gradient(135deg, var(--accent-from, #FF8E53) 0%, var(--accent-to, #FF6B6B) 100%);
  box-shadow: 0 10rpx 32rpx var(--game-card-shadow, rgba(0, 0, 0, 0.12));
  overflow: hidden;
}

.recent-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.section-eyebrow {
  font-size: 22rpx;
  opacity: 0.78;
}

.recent-title {
  font-size: 36rpx;
  font-weight: 800;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary, #2D3436);
}

.section-count {
  font-size: 24rpx;
  color: var(--text-secondary, #636E72);
}

/* 游戏网格 */
.game-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 游戏卡片 */
.game-card {
  position: relative;
  background: var(--game-card-bg, #FFFFFF);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 20rpx var(--game-card-shadow, rgba(0, 0, 0, 0.06));
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
}

/* 卡片背景层 */
.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: var(--home-card-tint-opacity, 0.5);
  z-index: 0;
}

/* 卡片内容层 */
.card-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

/* 游戏 Emoji 图标 */
.game-emoji {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}

/* 游戏信息 */
.game-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.game-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.game-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--primary, #FF6B6B);
}

.difficulty-pill {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--primary, #FF6B6B);
  background: rgba(255, 255, 255, 0.58);
}

.game-desc {
  font-size: 24rpx;
  color: var(--text-secondary, #636E72);
  opacity: 0.8;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}

.tag-pill {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--text-secondary, #636E72);
  background: rgba(255, 255, 255, 0.46);
}

/* 卡片悬停效果 */
.game-card-hover {
  transform: translateY(-4rpx) scale(1.02);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

/* ==================== 动画效果 ==================== */

/* 页面加载动画 */
.game-card {
  animation: slideInUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) backwards;
}

.game-card:nth-child(1) { animation-delay: 0.05s; }
.game-card:nth-child(2) { animation-delay: 0.1s; }
.game-card:nth-child(3) { animation-delay: 0.15s; }
.game-card:nth-child(4) { animation-delay: 0.2s; }
.game-card:nth-child(5) { animation-delay: 0.25s; }
.game-card:nth-child(6) { animation-delay: 0.3s; }
.game-card:nth-child(7) { animation-delay: 0.35s; }
.game-card:nth-child(8) { animation-delay: 0.4s; }

@keyframes slideInUp {
  from {
    transform: translateY(40rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
