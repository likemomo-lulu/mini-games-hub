<!-- 游戏列表页 - 精致卡片设计 -->
<view class="page-container" style="{{themeStyle}}">
  <!-- 头部区域 -->
  <view class="page-header">
    <view class="header-top">
      <view class="brand-section">
        <text class="brand-icon">🎮</text>
        <view class="brand-text">
          <text class="brand-title">盖姆小院</text>
          <text class="brand-subtitle">当前皮肤：{{currentThemeName}}</text>
        </view>
      </view>
      <view class="header-actions">
        <button class="theme-btn header-btn settings-btn" bindtap="onOpenSettings">
          <text class="theme-icon">🏔️</text>
          <text>设置</text>
        </button>
      </view>
    </view>

  </view>

  <!-- 游戏列表 -->
  <scroll-view class="game-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="scroll-content">
      <view
        wx:if="{{recentGame}}"
        class="recent-card"
        hover-class="game-card-hover"
        bindtap="onGameTap"
        data-id="{{recentGame.id}}"
        data-url="{{recentGame.url}}"
      >
        <view class="recent-copy">
          <text class="section-eyebrow">继续游玩</text>
          <text class="recent-title">{{recentGame.icon}} {{recentGame.title}}</text>
          <text class="recent-desc">{{recentGame.lastPlayedText || '上次玩到这里'}}</text>
        </view>
        <view class="recent-action">继续 →</view>
      </view>

    <view class="section-title-row">
      <text class="section-title">全部游戏</text>
      <text class="section-count">{{games.length}} 款</text>
    </view>

      <view class="game-grid">
        <view
          wx:for="{{games}}"
          wx:key="id"
          class="game-card"
          hover-class="game-card-hover"
          hover-stay-time="100"
          bindtap="onGameTap"
          data-id="{{item.id}}"
          data-url="{{item.url}}"
        >
          <view class="card-bg" style="background: {{item.cardBg}};"></view>
          <view class="card-content">
            <view class="game-emoji" style="background: {{item.iconBg}};">{{item.icon}}</view>
            <view class="game-info">
              <view class="game-title-row">
                <text class="game-title">{{item.title}}</text>
                <text class="difficulty-pill">{{item.difficulty}}</text>
              </view>
              <text class="game-desc">{{item.desc}}</text>
              <view class="tag-row">
              <text class="tag-pill">{{item.category}}</text>
              <text class="tag-pill" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
            </view>
          </view>
          </view>
          <view class="card-arrow">→</view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
