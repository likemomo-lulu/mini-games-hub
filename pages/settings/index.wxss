.settings-page {
  min-height: 100vh;
  background: var(--page-bg, #FFF5F0);
  color: var(--text-primary, #2D3436);
}

.settings-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding: 40rpx;
}

.settings-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.settings-icon {
  font-size: 60rpx;
}

.settings-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.settings-title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--primary, #FF6B6B);
}

.settings-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary, #636E72);
}

.settings-section {
  margin-bottom: 28rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: var(--game-card-bg, #FFFFFF);
  box-shadow: 0 8rpx 30rpx var(--game-card-shadow, rgba(0, 0, 0, 0.08));
}

.section-header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary, #2D3436);
}

.section-desc {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-secondary, #636E72);
}

.theme-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.theme-option {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  border: 3rpx solid transparent;
  background: var(--page-bg-solid, #FFF5F0);
}

.theme-option.active {
  border-color: var(--primary, #FF6B6B);
}

.theme-swatch {
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 18rpx var(--game-card-shadow, rgba(0, 0, 0, 0.14));
  flex-shrink: 0;
}

.theme-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.theme-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary, #2D3436);
}

.theme-desc {
  font-size: 22rpx;
  color: var(--text-secondary, #636E72);
}

.theme-check {
  width: 36rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--primary, #FF6B6B);
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.setting-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.setting-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary, #2D3436);
}

.setting-desc {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-secondary, #636E72);
}

.achievement-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.achievement-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: var(--page-bg-solid, #FFF5F0);
}

.achievement-item.locked {
  opacity: 0.58;
}

.achievement-medal {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 30rpx;
  background: rgba(255, 255, 255, 0.62);
  flex-shrink: 0;
}

.achievement-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.achievement-title {
  font-size: 27rpx;
  font-weight: 800;
  color: var(--text-primary, #2D3436);
}

.achievement-desc {
  font-size: 23rpx;
  line-height: 1.45;
  color: var(--text-secondary, #636E72);
}

.danger-section {
  margin-bottom: 28rpx;
}

.clear-btn {
  width: 100%;
  height: 88rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex !important;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: normal;
  color: var(--danger, #FF6B6B);
  background: rgba(255, 107, 107, 0.12);
}

.clear-btn::after {
  border: none;
}
