/* 接物品游戏样式 */

/* 容器 */
.container {
  min-height: 100vh;
  overflow: hidden; /* 防止横向滚动 */
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 头部信息栏 */
.header {
  width: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  background: linear-gradient(45deg, var(--gold-from, #FFD700), var(--gold-to, #FFA500));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* 统计信息 */
.stats {
  display: flex;
  gap: 15rpx;
}

.stat-box {
  padding: 15rpx 25rpx;
}

.stat-label {
  font-size: 20rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
}

/* 游戏区域 */
.game-board {
  width: 100%;
  max-width: 670rpx;
  border-radius: 30rpx;
  padding: 20rpx;
  position: relative;
  flex: 1;
  min-height: 400rpx; /* 最小高度，确保canvas有足够空间 */
  box-sizing: border-box;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
}

/* Canvas 画布 */
.game-canvas {
  width: 100%;
  height: 100%;
  flex: 1;
  border-radius: 20rpx;
}

/* 加载提示 */
.loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: var(--header-text-white, #FFFFFF);
  font-size: 28rpx;
}

/* 覆盖层 */
.overlay {
  border-radius: 30rpx;
}

.overlay-content {
  text-align: center;
  color: var(--header-text-white, #FFFFFF);
}

.overlay-title {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.overlay-info {
  font-size: 36rpx;
  margin-bottom: 15rpx;
  color: var(--header-text-white, #FFFFFF);
}

/* 控制按钮 */
.controls {
  width: 100%;
  max-width: 670rpx; /* 限制最大宽度，防止超出屏幕 */
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin: 40rpx auto 30rpx;
  box-sizing: border-box;
}

.btn {
  flex: 1;
  min-width: 0; /* 允许按钮缩小 */
  padding: 0;
  border-radius: 25rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.btn-move {
  background: linear-gradient(135deg, var(--primary, #74B9FF) 0%, var(--secondary, #0984E3) 100%);
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 操作提示 */
.tips {
  width: 100%;
  max-width: 670rpx;
  text-align: center;
  margin: 20rpx auto 0;
  font-size: 24rpx;
  padding-bottom: 30rpx;
  box-sizing: border-box;
}
