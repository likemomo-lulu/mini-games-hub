<!-- 水果大战游戏 -->
<view class="container" style="{{themeStyle}}">
  <!-- 头部信息栏 -->
  <view class="header game-topbar">
    <view class="game-title-block">
      <text class="game-title">水果大战</text>
      <text class="game-subtitle">点击水果，躲开炸弹</text>
    </view>
    <view class="stats game-stats">
      <view class="stat-box game-stat">
        <view class="stat-label">分数</view>
        <view class="stat-value">{{score}}</view>
      </view>
      <view class="stat-box game-stat">
        <view class="stat-label">时间</view>
        <view class="stat-value">{{timeLeft}}s</view>
      </view>
    </view>
  </view>

  <view class="best-record-bar">🏆 {{bestRecordText}}</view>

  <!-- 控制按钮 -->
  <view class="controls">
    <button
      wx:if="{{!gamePaused}}"
      class="btn"
      bindtap="startGame"
      disabled="{{gameRunning}}"
    >{{gameRunning ? '游戏中...' : (gameReady ? '重新开始' : '开始游戏')}}</button>
    <button
      wx:if="{{gameRunning}}"
      class="btn"
      bindtap="pauseGame"
    >暂停</button>
    <button
      wx:if="{{gamePaused}}"
      class="btn"
      bindtap="resumeGame"
    >继续</button>
  </view>

  <!-- 游戏区域 -->
  <view class="game-board">
    <!-- 水果列表 -->
    <view
      wx:for="{{fruits}}"
      wx:key="id"
      class="fruit"
      style="left: {{item.x}}px; top: {{item.y}}px; font-size: {{item.size}}px;"
      bindtap="onFruitTap"
      data-index="{{index}}"
    >{{item.emoji}}</view>

    <!-- 粒子特效列表 -->
    <view
      wx:for="{{particles}}"
      wx:key="id"
      class="particle {{item.type === 'bomb' ? 'particle-bomb' : ''}}"
      style="left: {{item.x}}px; top: {{item.y}}px; width: {{item.size}}px; height: {{item.size}}px; background-color: {{item.color}}; opacity: {{item.life}};"
    ></view>

    <!-- 游戏准备覆盖层 -->
    <view class="overlay show pause-overlay-card" wx:if="{{gamePaused}}">
      <view class="overlay-content">
        <view class="overlay-title">⏸️ 暂停中</view>
        <view class="overlay-info">点击继续按钮恢复游戏</view>
      </view>
    </view>

    <!-- 游戏结束覆盖层 -->
    <view class="overlay game-over {{!gameRunning && gameReady && !gamePaused && timeLeft <= 0 ? 'show' : ''}}" wx:if="{{!gameRunning && gameReady && !gamePaused && timeLeft <= 0}}">
      <view class="overlay-content">
        <view class="overlay-title">🎉 时间到！</view>
        <view class="overlay-text">最终得分</view>
        <view class="overlay-score">{{score}}</view>
        <view class="overlay-buttons">
        <button class="btn btn-restart" bindtap="startGame">再来一次</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作提示 -->
  <view class="tips">
    💡 点击水果得分 | 星星 +50 | 炸弹 -30 | 闪电清屏
  </view>
</view>
