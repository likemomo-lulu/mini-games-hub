/* 打水果游戏样式 */

/* 容器 */
.container {
  height: 100vh;
  overflow: hidden;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
}

/* 头部信息栏 */
.header {
  width: 100%;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}

.stats {
  display: flex;
  justify-content: flex-end;
  gap: 15rpx;
  padding: 0 10rpx;
}

.stat-box {
  padding: 15rpx 25rpx;
}

.stat-label {
  font-size: 20rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
}

/* 控制按钮 */
.controls {
  width: 100%;
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  margin-bottom: 30rpx;
}

.btn {
  flex: 1;
  padding: 0;
  border-radius: 25rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn[disabled] {
  opacity: 0.5;
}

/* 游戏区域 */
.game-board {
  position: relative;
  width: 100%;
  max-width: 670rpx;
  backdrop-filter: blur(10px);
  border-radius: 30rpx;
  padding: 24rpx;
  overflow: hidden;
  margin: 0 auto;
  flex: 1;
  box-sizing: border-box;
}

/* 水果样式 */
.fruit {
  position: absolute;
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  user-select: none;
  transition: transform 0.1s;
}

.fruit:active {
  transform: scale(0.9);
}

/* 粒子特效 */
.particle {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

/* 💥 炸弹粒子 - 星形爆炸效果 */
.particle-bomb {
  border-radius: 0;
  /* 创建爆炸星形：8个角的星形 */
  clip-path: polygon(
    50% 0%,
    61% 35%,
    98% 35%,
    68% 57%,
    79% 91%,
    50% 70%,
    21% 91%,
    32% 57%,
    2% 35%,
    39% 35%
  );
}

/* 覆盖层 */
.overlay {
  border-radius: 30rpx;
}

.overlay-content {
  text-align: center;
}

.overlay-title {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.overlay.game-over .overlay-title {
  background: linear-gradient(45deg, var(--gold-from, #FFD700), var(--gold-to, #FFA500));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.overlay-text {
  font-size: 32rpx;
  margin-bottom: 30rpx;
}

.overlay-score {
  font-size: 80rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
  background: linear-gradient(45deg, var(--accent-from, #F093FB), var(--accent-to, #F5576C));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.overlay-buttons {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

/* 操作提示 */
.tips {
  text-align: center;
  margin-top: 30rpx;
  font-size: 24rpx;
}
