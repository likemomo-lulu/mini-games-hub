<!-- 华容道游戏页 -->
<view class="container" style="{{themeStyle}}">
  <view class="header game-topbar">
    <view class="game-title-block">
      <text class="game-title">华容道</text>
      <text class="game-subtitle">拖动滑块，送曹操出关</text>
    </view>
    <view class="header-right game-stats">
      <view class="level-box stat-box game-stat">
        <text class="score-label stat-label">关卡</text>
        <text class="score-value stat-value">{{currentLevel + 1}}</text>
      </view>
      <view class="step-box stat-box game-stat">
        <text class="score-label stat-label">步数</text>
        <text class="score-value stat-value">{{steps}}</text>
      </view>
    </view>
  </view>

  <view class="best-record-bar">🏆 {{bestRecordText}}</view>

  <view class="controls">
    <button
      class="btn btn-restart"
      bindtap="restart"
    >重新开始</button>
    <button
      class="btn btn-select-level"
      bindtap="toggleLevelModal"
    >选择关卡</button>
  </view>

  <view class="game-board">
    <canvas
      type="2d"
      id="gameCanvas"
      class="game-canvas"
      style="width: 552rpx; height: 442rpx;"
      hidden="{{showLevelModal}}"
      bindtouchstart="onTouchStart"
      catchtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
    ></canvas>

    <view class="game-over overlay {{gameOver ? 'show' : ''}}">
      <text class="game-over-title overlay-title overlay-title-win">🎉 胜利！</text>
      <text class="game-over-score">用了 {{steps}} 步</text>
      <button class="btn btn-next-level" bindtap="nextLevel">下一关</button>
    </view>
  </view>

  <view class="tips">
    💡 拖动滑块，把曹操移到下方出口
  </view>

  <!-- 关卡选择浮窗 -->
  <view class="level-modal app-modal {{showLevelModal ? 'show' : ''}}" bindtap="toggleLevelModal">
    <view class="level-modal-content app-modal-content" catchtap="stopPropagation">
      <view class="level-modal-header">
        <text class="level-modal-title">选择关卡</text>
        <text class="level-modal-close" bindtap="toggleLevelModal">✕</text>
      </view>
      <scroll-view class="level-list" scroll-y>
        <view
          wx:for="{{LEVELS}}"
          wx:key="id"
          class="level-item {{currentLevel === index ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="selectLevel"
        >
          <view class="level-item-number">{{index + 1}}</view>
          <view class="level-item-info">
            <text class="level-item-name">{{item.name}}</text>
            <text class="level-item-steps">最优 {{item.minSteps}} 步</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
