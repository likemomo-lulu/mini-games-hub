.container {
  padding: 40rpx;
  height: 100vh;
  max-height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

.header {
  width: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}

.header-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  flex: 1;
}

.level-box,
.step-box {
  padding: 15rpx 25rpx;
}

.score-label {
  font-size: 20rpx;
}

.score-value {
  font-size: 32rpx;
}

.controls {
  width: 100%;
  margin-top: 40rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.btn {
  flex: 1;
  max-width: 350rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.game-board {
  position: relative;
  width: 552rpx;
  height: 442rpx;
  border-radius: 40rpx;
  padding: 24rpx;
}

.game-canvas {
  width: 552rpx;
  height: 442rpx;
  border-radius: 24rpx;
  position: relative;
  z-index: 1;
}

.game-over {
  border-radius: 40rpx;
}

.game-over.show {
  opacity: 1;
  pointer-events: auto;
}

.game-over-title {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.game-over-score {
  font-size: 40rpx;
  color: var(--header-text-white, #FFFFFF);
  margin-bottom: 50rpx;
}

.game-over .btn {
  height: 50rpx;
  line-height: 50rpx;
  padding: 0;
  box-sizing: border-box;
  min-height: 32rpx;
}

.tips {
  margin-top: 40rpx;
  font-size: 28rpx;
}

/* 关卡选择浮窗 */
.level-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 100;
}

.level-modal.show {
  opacity: 1;
  pointer-events: auto;
}

.level-modal-content {
  width: 600rpx;
  max-height: 80vh;
  background: var(--game-card-bg, #FFFFFF);
  border-radius: 30rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.4);
}

.level-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  color: var(--button-primary-text, #FFFFFF);
  background: linear-gradient(135deg, var(--accent-from, #FF8E53) 0%, var(--accent-to, #FF6B6B) 100%);
}

.level-modal-title {
  font-size: 36rpx;
  font-weight: bold;
}

.level-modal-close {
  font-size: 48rpx;
  color: var(--button-primary-text, #FFFFFF);
  padding: 0 10rpx;
}

.level-list {
  max-height: 60vh;
  padding: 20rpx;
}

.level-item {
  display: flex;
  align-items: center;
  padding: 25rpx;
  margin-bottom: 15rpx;
  background: var(--page-bg-solid, #F5F5F5);
  border-radius: 20rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.level-item.active {
  border-color: var(--primary, #667EEA);
}

.level-item-number {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  color: var(--button-primary-text, #FFFFFF);
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--accent-from, #FF8E53) 0%, var(--accent-to, #FF6B6B) 100%);
}

.level-item.active .level-item-number {
  background: var(--game-card-bg, #FFFFFF) !important;
  color: var(--primary, #667EEA);
}

.level-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.level-item-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary, #333333);
}

.level-item-steps {
  font-size: 24rpx;
  color: var(--text-secondary, #999999);
}
