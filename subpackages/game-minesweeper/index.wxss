/* 扫雷游戏样式 */

/* 容器 */
.container {
  height: 100vh;
  overflow: hidden;
  padding: 30rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 头部信息栏 */
.header {
  width: 100%;
  max-width: 670rpx;
  margin: 20rpx auto 40rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 0;
  box-sizing: border-box;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--gold-from, #F6E313);
}

/* 统计信息 */
.stats {
  display: flex;
  gap: 15rpx;
}

.stat-box {
  padding: 15rpx 25rpx;
}

.stat-label {
  font-size: 20rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
}

/* 控制按钮 */
.controls {
  width: 100%;
  max-width: 670rpx;
  display: flex;
  justify-content: center;
  margin: 40rpx auto 30rpx;
  box-sizing: border-box;
}

.btn {
  flex: 1;
  min-width: 0;
  padding: 0;
  border-radius: 25rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 游戏棋盘 */
.game-board {
  width: 100%;
  max-width: 670rpx;
  margin: 0 auto;
  border-radius: 30rpx;
  padding: 20rpx;
  position: relative;
  box-sizing: border-box;
}

/* 9x9 网格 */
.grid {
  display: grid;
  grid-template-columns: repeat(9, 1fr);
  gap: 6rpx;
  aspect-ratio: 1;
}

/* 格子 */
.cell {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
}

.cell-content {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 未揭开的格子 */
.cell.covered .cell-content {
  background: linear-gradient(135deg, var(--accent-from, #A8EDEA) 0%, var(--accent-to, #FED6E3) 100%);
}

/* 已揭开的格子 */
.cell.revealed .cell-content {
  background: var(--panel-bg, rgba(255, 255, 255, 0.3));
}

/* 插旗的格子 */
.cell.flagged .cell-content {
  background: linear-gradient(135deg, var(--gold-from, #FFECD2) 0%, var(--gold-to, #FCB69F) 100%);
}

.flag {
  font-size: 32rpx;
}

/* 踩雷的格子 */
.cell.mine .cell-content {
  background: linear-gradient(135deg, var(--danger, #FF6B6B) 0%, var(--accent-to, #EE5A5A) 100%);
  animation: shake 0.5s ease;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}

/* 数字颜色 */
.cell-1 { color: #0000ff; }
.cell-2 { color: #008000; }
.cell-3 { color: #ff0000; }
.cell-4 { color: #000080; }
.cell-5 { color: #800000; }
.cell-6 { color: #008080; }
.cell-7 { color: #000000; }
.cell-8 { color: #808080; }

/* 覆盖层 */
.overlay {
  border-radius: 30rpx;
}

.overlay-content {
  text-align: center;
}

.overlay-text {
  font-size: 36rpx;
  margin-bottom: 30rpx;
}

.overlay-info {
  font-size: 32rpx;
  margin-bottom: 15rpx;
}

/* 操作提示 */
.tips {
  width: 100%;
  max-width: 670rpx;
  text-align: center;
  margin: 30rpx auto 0;
  font-size: 24rpx;
  line-height: 1.6;
  box-sizing: border-box;
}
