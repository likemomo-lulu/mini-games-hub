<!-- 2048 游戏页 - 精致设计 -->
<view class="container" style="{{themeStyle}}">
  <!-- 头部信息栏 -->
  <view class="header game-topbar">
    <view class="game-title-block">
      <text class="game-title">2048</text>
      <text class="game-subtitle">滑动合并数字</text>
    </view>
    <view class="header-right game-stats">
      <view class="stat-box game-stat">
        <text class="stat-label">步数</text>
        <text class="stat-value">{{steps}}</text>
      </view>
      <view class="stat-box game-stat">
        <text class="stat-label">分数</text>
        <text class="stat-value">{{score}}</text>
      </view>
    </view>
  </view>

  <view class="best-record-bar">🏆 {{bestRecordText}}</view>

  <!-- 控制按钮 -->
  <view class="controls">
    <button class="btn" bindtap="restart">重新开始</button>
  </view>

  <!-- 游戏棋盘 -->
  <view class="game-board">
    <canvas
      type="2d"
      id="gameCanvas"
      class="game-canvas"
      style="width: 552rpx; height: 552rpx;"
      bindtouchstart="onTouchStart"
      catchtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
    ></canvas>

    <!-- 游戏结束覆盖层 -->
    <view class="overlay {{gameOver ? 'show' : ''}}">
      <view class="overlay-content">
        <text class="overlay-title overlay-title-danger">游戏结束</text>
        <text class="overlay-info">最终得分: {{score}}</text>
        <button class="btn" bindtap="restart">再来一局</button>
      </view>
    </view>

    <!-- 达成 2048 覆盖层 -->
    <view class="overlay {{showWin ? 'show' : ''}}">
      <view class="overlay-content">
        <text class="overlay-title overlay-title-win">达成 2048！</text>
        <text class="overlay-info">当前得分: {{score}}</text>
        <button class="btn" bindtap="continueGame">继续挑战</button>
        <button class="btn btn-secondary" bindtap="restart">重新开始</button>
      </view>
    </view>
  </view>

  <!-- 操作提示 -->
  <view class="tips">
    💡 滑动移动方块，合并相同数字
  </view>
</view>
